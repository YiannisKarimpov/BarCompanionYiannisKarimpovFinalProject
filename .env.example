# Copy to .env for local development. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL locally (create the database first). Leave unset to use SQLite.
DATABASE_URL=postgres://postgres:password@localhost:5432/barcompanion
# TheCocktailDB key. "1" is the free test key (development only).
COCKTAILDB_API_KEY=1
